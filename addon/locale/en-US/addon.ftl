appearance-title = Translation appearance
appearance-font-size-label = Font size
appearance-font-size-help = 10–32 px. Applies to the translation block; saved changes apply to open readers immediately.
appearance-color-label = Text color
appearance-color-help = Leave empty to follow Zotero's theme, or enter a CSS color such as #333333.
appearance-font-family-label = Font family
appearance-font-family-help = Comma-separated CSS font names, for example Georgia, serif. Leave empty to inherit the reader font.
appearance-line-height-label = Line height
appearance-line-height-help = Between 1 and 2.5. The default is 1.75.
appearance-paragraph-spacing-label = Paragraph spacing (em)
appearance-paragraph-spacing-help = 0–3 em below each translation block. The default is 1.25.
appearance-background-label = Background
appearance-background-help = Leave empty for transparent, or enter a CSS color such as #f6f6f6.
appearance-theme-label = Theme
appearance-theme-auto = Follow Zotero
appearance-theme-light = Light
appearance-theme-dark = Dark
appearance-theme-help = Sets the translation block colors. Text color and background above override the theme.
appearance-underline-label = Underline translation
appearance-underline-color-label = Underline color
appearance-underline-color-help = Leave empty to match the text color.
appearance-ribbon-label = Show left ribbon
appearance-ribbon-color-label = Ribbon color
appearance-ribbon-color-help = The ribbon marks each translation block.

settings-intro = Interlinear shows the source text and a translation paragraph by paragraph in Zotero 10's new PDF reader. It uses Google Translate by default (no API key required); you can also choose an OpenAI-compatible endpoint, Anthropic Claude, Google Gemini, Ollama, or Translate for Zotero.
settings-privacy-notice = Privacy note: when translation is enabled, paragraph text is sent to the translation service you choose. Do not translate documents containing sensitive information unless you trust that service.
provider-engine-label = Translation backend
provider-engine-google = Google Translate (free, no API key)
provider-engine-openai = OpenAI-compatible (Ollama / LM Studio / relays)
provider-engine-claude = Anthropic Claude
provider-engine-gemini = Google Gemini
provider-engine-ollama = Ollama (native API)
provider-engine-pdftranslate = Translate for Zotero
language-title = Languages
language-source-label = Source language
language-target-label = Target language
language-help = With "Auto-detect" the service identifies the source language. The target language also separates cache entries.
language-name-auto = Auto-detect
language-name-en = English
language-name-zh-CN = Chinese (Simplified)
language-name-zh-TW = Chinese (Traditional)
language-name-ja = Japanese
language-name-ko = Korean
language-name-fr = French
language-name-de = German
language-name-es = Spanish
language-name-ru = Russian
language-name-pt = Portuguese
language-name-it = Italian
language-name-ar = Arabic
language-name-hi = Hindi
display-mode-title = Display mode
display-mode-label = Layout
display-mode-top-bottom = Source above translation
display-mode-side-by-side = Side by side
display-mode-target-only = Translation only
display-mode-source-only = Source only
display-mode-help = All modes keep each translation anchored to its paragraph. Side-by-side fits two columns without moving Zotero's text, so native highlights stay aligned.
provider-google-title = Google Translate
provider-google-base-label = Service URL
provider-google-base-help = Defaults to https://translate.googleapis.com. If it is unreachable, enter a mirror or proxy you trust; /translate_a/single is appended automatically.
provider-google-help = Uses the free client=gtx endpoint and needs no API key. Requests go to the URL above.
provider-openai-title = OpenAI-compatible endpoint
provider-openai-endpoint-label = Endpoint
provider-openai-endpoint-help = Full Chat Completions URL, for example http://127.0.0.1:11434/v1/chat/completions or https://api.openai.com/v1/chat/completions.
provider-openai-model-label = Model
provider-openai-api-key-label = API key
provider-openai-api-key-help = Leave empty for local or unauthenticated services. The key is stored only in Zotero preferences and never written to logs or cache tags.
provider-openai-temperature-label = Temperature
provider-openai-temperature-help = 0–2, default 0.2. Lower values keep translations more consistent.
provider-openai-prompt-label = System prompt
provider-openai-prompt-help = Translation instructions for every paragraph. Language and BRSEG marker requirements are appended automatically.
provider-claude-title = Anthropic Claude
provider-claude-endpoint-label = Endpoint
provider-claude-endpoint-help = Messages API URL. Defaults to https://api.anthropic.com/v1/messages; compatible relays are also accepted.
provider-claude-model-label = Model
provider-claude-api-key-label = API key
provider-claude-api-key-help = Sent in the x-api-key header. Stored only in Zotero preferences and never written to logs or cache tags.
provider-claude-temperature-label = Temperature
provider-claude-temperature-help = 0–1, default 0.2. Lower values keep translations more consistent.
provider-claude-prompt-label = System prompt
provider-claude-prompt-help = Translation instructions for every paragraph. Language and BRSEG marker requirements are appended automatically.
provider-gemini-title = Google Gemini
provider-gemini-base-label = Service URL
provider-gemini-base-help = Defaults to https://generativelanguage.googleapis.com; /v1beta/models/<model>:generateContent is appended automatically.
provider-gemini-model-label = Model
provider-gemini-api-key-label = API key
provider-gemini-api-key-help = Sent in the x-goog-api-key header, never in the URL. Stored only in Zotero preferences and never written to logs or cache tags.
provider-gemini-temperature-label = Temperature
provider-gemini-temperature-help = 0–2, default 0.2. Lower values keep translations more consistent.
provider-gemini-prompt-label = System prompt
provider-gemini-prompt-help = Translation instructions for every paragraph. Language and BRSEG marker requirements are appended automatically.
glossary-title = Glossary
glossary-help = One term per line as source,target (CSV) or source→target separated by a tab (TSV). A source,target header and # comment lines are optional. Terms are appended to the prompt for OpenAI-compatible, Claude, Gemini and Ollama backends; Google Translate and Translate for Zotero ignore the glossary.
